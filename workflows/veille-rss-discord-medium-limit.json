    {
      "parameters": {
        "jsCode": "// Dedup + tri + limite Medium\n\nconst items = $input.all();\nconst store = $getWorkflowStaticData('global');\n\nif (!store.sentLinks) store.sentLinks = {};\n\nconst now = Date.now();\nconst THIRTY_DAYS = 30 * 24 * 60 * 60 * 1000;\n\n// nettoyage mémoire\nfor (const k of Object.keys(store.sentLinks)) {\n  if (now - store.sentLinks[k] > THIRTY_DAYS) delete store.sentLinks[k];\n}\n\nfunction pickDate(j) {\n  const d = j.isoDate || j.pubDate || j.published || j.date;\n  const t = new Date(d || 0).getTime();\n  return isNaN(t) ? 0 : t;\n}\n\nfunction pickLink(j) {\n  return (j.link || j.url || j.guid || '').trim();\n}\n\nfunction sourceBucket(link) {\n  if (!link) return 'other';\n  if (link.includes('medium.com')) return 'medium';\n  return 'other';\n}\n\nconst normalized = items.map(i => {\n  const j = i.json;\n  const link = pickLink(j);\n  const ts = pickDate(j);\n\n  return {\n    json: {\n      title: (j.title || 'Sans titre').replace(/<[^>]*>/g, '').trim(),\n      link,\n      creator: j.creator || j['dc:creator'] || '',\n      ts,\n      bucket: sourceBucket(link)\n    }\n  };\n});\n\nconst filtered = normalized.filter(it => {\n  const j = it.json;\n  const key = j.link || j.title + j.ts;\n\n  if (!key) return false;\n  if (store.sentLinks[key]) return false;\n\n  j._key = key;\n  return true;\n});\n\nfiltered.sort((a,b)=> b.json.ts - a.json.ts);\n\nconst MAX_TOTAL = 10;\nconst MAX_MEDIUM = 3;\n\nlet mediumCount = 0;\nconst selected = [];\n\nfor (const it of filtered) {\n\n  if (selected.length >= MAX_TOTAL) break;\n\n  if (it.json.bucket === 'medium') {\n    if (mediumCount >= MAX_MEDIUM) continue;\n    mediumCount++;\n  }\n\n  selected.push(it);\n}\n\nfor (const it of selected) {\n  store.sentLinks[it.json._key] = now;\n}\n\nif (selected.length === 0) {\n  return [{ json: { noArticles: true } }];\n}\n\nreturn selected;"
      },
      "name": "Dedup & Sort",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        624,
        240
      ],
      "id": "a674ae4b-410a-4938-874d-260d4a9f4c0b"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nif (items.length === 1 && items[0].json.noArticles) {\n  return [{ json: { content: '📭 Veille Data Engineering — Aucun nouvel article.' } }];\n}\n\nlet message = '🧠 **Veille Data Engineering** — ' + new Date().toLocaleDateString('fr-FR') + '\\n\\n';\n\nitems.forEach((item,i)=>{\n\n const j = item.json;\n const title = j.title || 'Sans titre';\n const link = j.link || '';\n const author = j.creator || '';\n\n message += `**${i+1}.** ${title}${author ? ' — _'+author+'_' : ''}\\n${link}\\n\\n`;\n\n});\n\nif (message.length > 1950) {\n message = message.substring(0,1950) + '\\n\\n… _(liste tronquée)_';\n}\n\nreturn [{json:{content:message}}];"
      },
